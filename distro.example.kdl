(barney)version 1

/// Example distro configuration

/// Declare our project with `ID` equal to `brogstrapa`
project "bny-base" {
    name "Barney Base "
    summary "A properly engineered distro"

    // maps to os-release fields
    links {
        home "https://github.com/barney-build/bny-base"
        bugs "https://github.com/barney-build/bny-base/issues"
    }
}
