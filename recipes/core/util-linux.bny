(bny::recipe)version 1

recipe util-linux {
    version "2.42.4"
    release 1

    summary "util-linux is a random collection of Linux utilities"
    description "util-linux is a random collection of Linux utilities"

    properties {
        (bool) with_systemd #true
    }

    variant "bootstrap" {
        with_systemd #false
    }

    requires {
        (binary)make

        match (prop)with_systemd {
            when #true {
                util-linux variant="bootstrap"
                systemd
            } otherwise {}
        }
    }

    build {
        match (prop)with_systemd {
            when #true {
                autotools::configure "--enable-systemd"
            }
            otherwise {
                autotools::configure
            }
        }
        autotools::make
        autotools::make_install
    }
}
