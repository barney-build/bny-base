(bny::recipe)version 1

recipe systemd {
    version "261.4"
    release 1

    summary "System and service manager"
    description "systemd is a suite of basic building blocks for a Linux system."

    properties {
        (bool)with_utillinux #true
    }

    variant "bootstrap" {
        with_utillinux #false
    }

    requires {
        (binary)make
        match (prop)with_utillinux {
            when #true {
                systemd variant="bootstrap"
                util-linux
            } otherwise { }
        }
    }
}
