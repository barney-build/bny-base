(barney)version 1

// Environment module.
//
// Stable binding of variables in the current phase.
module env {
  properties {
    (string) target (prop)phase::target
    (string) prefix (prop)phase::prefix
  }

  // exported into the shell environment
  exports {
    // exported as ENV_PREFIX
    PREFIX (var)prefix
    TARGET (var)target
  }
}
